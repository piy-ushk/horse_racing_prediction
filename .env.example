# Copy this file to .env and fill in your values.
# Never commit .env to version control.

WP_BASE_URL=https://www.keiba-tips.top
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

JRAVAN_LICENSE_KEY=XXXX-XXXX-XXXX-XXXX-X
JRAVAN_SOFTWARE_ID=

# UmaConn is a Windows COM DLL (NVDTLabLib.NVLink) — no HTTP URL needed
UMACONN_API_KEY=XXXX-XXXX-XXXX-XXXX-X

DEMO_MODE=true
SCHEDULED_HOUR=9
SCHEDULED_MINUTE=30
